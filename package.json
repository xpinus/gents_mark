{
  "name": "gents-mark",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The discreet bookmark companion for gentlemen.",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build",
    "build:zip": "npm run build && node scripts/zip-dist.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "npm run typecheck && npm test && node scripts/verify-dist.mjs",
    "icons": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/generate-icons.ps1"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "2.7.1",
    "@types/chrome": "0.2.7",
    "@types/node": "26.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
